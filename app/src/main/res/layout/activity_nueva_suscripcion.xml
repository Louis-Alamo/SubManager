<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/cd_back_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/black" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/form_subscription_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            app:layout_constraintBottom_toBottomOf="@+id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnBack" />

        <TextView
            android:id="@+id/btnGuardarTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/form_save"
            android:textAllCaps="true"
            android:textColor="#3F51B5"
            android:textStyle="bold"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTitle" />

        <FrameLayout
            android:id="@+id/avatarContainer"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle">

            <ImageView
                android:id="@+id/ivSuscripcionAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/circle_avatar_bg"
                android:padding="28dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_letter_s" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabEditAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                app:fabCustomSize="36dp"
                app:srcCompat="@android:drawable/ic_menu_edit"
                app:tint="@android:color/white"
                android:backgroundTint="#2196F3"
                android:contentDescription="@string/cd_user_avatar" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/formFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@+id/avatarContainer">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/form_field_name_label">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/form_field_amount_label"
                app:prefixText="@string/form_field_amount_prefix"
                app:prefixTextColor="@android:color/black">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMonto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/form_field_billing_cycle_label">
                <AutoCompleteTextView
                    android:id="@+id/autoCompleteCiclo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFecha"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/form_field_first_charge_label"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calendar_today">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="true"
                    android:hint="mm/dd/yyyy" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFechaLimite"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="@string/form_field_cancel_date_label"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calendar_today">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFechaLimite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="true"
                    android:hint="mm/dd/yyyy (Opcional)" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_field_appearance_label"
                android:textColor="#3F51B5"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:id="@+id/llColorPicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView android:id="@+id/colorBlue" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/circle_avatar_bg" app:tint="#2196F3" android:padding="2dp" android:layout_marginEnd="12dp" android:tag="#2196F3" android:contentDescription="Azul"/>
                    <ImageView android:id="@+id/colorPurple" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/circle_avatar_bg" app:tint="#9C27B0" android:padding="2dp" android:layout_marginEnd="12dp" android:tag="#9C27B0" android:contentDescription="Morado" android:alpha="0.4"/>
                    <ImageView android:id="@+id/colorGreen" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/circle_avatar_bg" app:tint="#4CAF50" android:padding="2dp" android:layout_marginEnd="12dp" android:tag="#4CAF50" android:contentDescription="Verde" android:alpha="0.4"/>
                    <ImageView android:id="@+id/colorOrange" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/circle_avatar_bg" app:tint="#FF9800" android:padding="2dp" android:layout_marginEnd="12dp" android:tag="#FF9800" android:contentDescription="Naranja" android:alpha="0.4"/>
                    <ImageView android:id="@+id/colorRed" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/circle_avatar_bg" app:tint="#F44336" android:padding="2dp" android:layout_marginEnd="12dp" android:tag="#F44336" android:contentDescription="Rojo" android:alpha="0.4"/>
                    <ImageView android:id="@+id/colorPink" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/circle_avatar_bg" app:tint="#E91E63" android:padding="2dp" android:layout_marginEnd="12dp" android:tag="#E91E63" android:contentDescription="Rosa" android:alpha="0.4"/>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_field_category_label"
                android:textColor="#3F51B5"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="24dp">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCategorias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/form_field_payment_method_label">
                <AutoCompleteTextView
                    android:id="@+id/autoCompletePago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@+id/formFields" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/form_save"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="16dp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>