<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="11dp"
    android:background="?attr/selectableItemBackground">


    <ImageView
        android:id="@+id/ivUpcomingIcon"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


    <TextView
        android:id="@+id/tvNombreServicio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:text="Servicio"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/ivUpcomingIcon"
        app:layout_constraintEnd_toStartOf="@id/llRight"
        app:layout_constraintTop_toTopOf="@id/ivUpcomingIcon"
        app:layout_constraintBottom_toTopOf="@id/tvDiasRestantes" />


    <TextView
        android:id="@+id/tvDiasRestantes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:text="Digital · Mensual"
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        app:layout_constraintStart_toEndOf="@id/ivUpcomingIcon"
        app:layout_constraintEnd_toStartOf="@id/llRight"
        app:layout_constraintTop_toBottomOf="@id/tvNombreServicio"
        app:layout_constraintBottom_toBottomOf="@id/ivUpcomingIcon" />


    <LinearLayout
        android:id="@+id/llRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvMontoUpcoming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-$0.00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvBadgeDias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 días"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_status_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginTop="5dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
