<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <!-- APP BAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingHorizontal="4dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_forward"
                    android:rotation="180"
                    android:tint="@color/text_primary"
                    android:contentDescription="@string/cd_back_button"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Detalle"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnEdit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_edit"
                    android:tint="@color/primary"
                    android:contentDescription="@string/cd_more_options"
                    android:background="?attr/selectableItemBackgroundBorderless" />

            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <!-- ── HERO CARD: Ícono + Nombre + Monto ──────────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="28dp">

                    <!-- Ícono -->
                    <ImageView
                        android:id="@+id/ivDetalleIcon"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:scaleType="fitCenter"
                        android:background="@drawable/bg_status_badge"
                        android:backgroundTint="#33FFFFFF"
                        android:padding="16dp"
                        android:contentDescription="@null" />

                    <!-- Nombre -->
                    <TextView
                        android:id="@+id/tvDetalleName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Netflix Premium"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp" />

                    <!-- Categoría -->
                    <TextView
                        android:id="@+id/tvDetalleCategoria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entretenimiento"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />

                    <!-- Monto grande -->
                    <TextView
                        android:id="@+id/tvDetalleMonto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$219.00"
                        android:textColor="#FFFFFF"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/tvDetalleCiclo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="por mes"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp" />

                    <!-- Badge estado -->
                    <TextView
                        android:id="@+id/tvDetalleEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activa"
                        android:textColor="#16A34A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_status_badge"
                        android:backgroundTint="#DCFCE7"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:layout_marginTop="14dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── INFO CARDS ──────────────────────────────────────── -->

            <!-- Próximo cobro -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Fila: Próximo cobro -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="18dp">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp">
                            <View android:layout_width="38dp" android:layout_height="38dp"
                                android:background="@drawable/bg_status_badge"
                                android:backgroundTint="@color/error_bg"/>
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_calendar"
                                android:tint="@color/error" android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Próximo cobro" android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                            <TextView android:id="@+id/tvProximoCobro"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="14 Abr 2026" android:textColor="@color/text_primary"
                                android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tvDiasParaVencer"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="En 3 días" android:textColor="@color/error"
                            android:textSize="12sp" android:textStyle="bold"
                            android:background="@drawable/bg_status_badge"
                            android:backgroundTint="@color/error_bg"
                            android:paddingHorizontal="10dp" android:paddingVertical="4dp"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginHorizontal="18dp" android:background="@color/border"/>

                    <!-- Fila: Ciclo de facturación -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="18dp">

                        <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
                            <View android:layout_width="38dp" android:layout_height="38dp"
                                android:background="@drawable/bg_status_badge"
                                android:backgroundTint="@color/primary_tint"/>
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_clock" android:tint="@color/primary"
                                android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Ciclo de facturación" android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                            <TextView android:id="@+id/tvCicloInfo"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Mensual" android:textColor="@color/text_primary"
                                android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginHorizontal="18dp" android:background="@color/border"/>

                    <!-- Fila: Método de pago -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="18dp">

                        <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
                            <View android:layout_width="38dp" android:layout_height="38dp"
                                android:background="@drawable/bg_status_badge"
                                android:backgroundTint="@color/success_bg"/>
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_card" android:tint="@color/success"
                                android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Método de pago" android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                            <TextView android:id="@+id/tvMetodoPago"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Tarjeta de crédito" android:textColor="@color/text_primary"
                                android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginHorizontal="18dp" android:background="@color/border"/>

                    <!-- Fila: Recordatorio -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="18dp">

                        <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
                            <View android:layout_width="38dp" android:layout_height="38dp"
                                android:background="@drawable/bg_status_badge"
                                android:backgroundTint="#EDE9FE"/>
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_notifications" android:tint="#7C3AED"
                                android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Recordatorio" android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                            <TextView android:id="@+id/tvRecordatorio"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="3 días antes" android:textColor="@color/text_primary"
                                android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginHorizontal="18dp" android:background="@color/border"/>

                    <!-- Fila: Último día para cancelar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="18dp">

                        <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
                            <View android:layout_width="38dp" android:layout_height="38dp"
                                android:background="@drawable/bg_status_badge"
                                android:backgroundTint="#FFF7ED"/>
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_warning" android:tint="@color/warning"
                                android:contentDescription="@null"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Último día para cancelar" android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                            <TextView android:id="@+id/tvCancelDate"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="11 Abr 2026 · 3 días" android:textColor="@color/warning"
                                android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── ÚLTIMOS PAGOS ───────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ÚLTIMOS PAGOS"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvUltimosPagos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </androidx.cardview.widget.CardView>

            <!-- ── BOTONES DE ACCIÓN ───────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEliminar"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Eliminar"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/error_bg"
                    android:textColor="@color/error"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/error"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarcarPagado"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="2"
                    android:text="Marcar como Pagado"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary"
                    app:cornerRadius="14dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
